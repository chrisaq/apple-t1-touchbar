[Unit]
Description=Activate Apple T1 Touch Bar in keyboard mode
After=multi-user.target

[Service]
# Starting the process does not hold up the graphical target while modules load.
Type=exec
ExecStart=/usr/bin/apple-t1-touchbar-activate
RemainAfterExit=yes
Restart=no
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical.target
